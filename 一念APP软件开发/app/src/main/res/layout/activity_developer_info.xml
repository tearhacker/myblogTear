<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/love_bg">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/love_bg_romantic"/>

    <tear.conception.ui.view.HeartParticleView
        android:id="@+id/heart_particle_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="70dp"
            android:paddingBottom="40dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp">

            <FrameLayout
                android:id="@+id/fl_avatar_container"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:alpha="0"
                android:translationY="-30dp">

                <ImageView
                    android:id="@+id/iv_developer_avatar"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_gravity="center"
                    android:src="@drawable/myheada"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_avatar_rounded"/>

            </FrameLayout>

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="表白者"
                android:textSize="26sp"
                android:textColor="@color/love_primary"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:alpha="0"
                android:letterSpacing="0.15"/>

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="一念的开发者"
                android:textSize="13sp"
                android:textColor="@color/love_text_light"
                android:layout_marginTop="6dp"
                android:alpha="0"/>

            <LinearLayout
                android:id="@+id/ll_section_identity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="20dp"
                android:layout_marginTop="28dp"
                android:alpha="0"
                android:translationY="30dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👨‍💻"
                        android:textSize="20sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="开发者身份"
                        android:textSize="17sp"
                        android:textColor="@color/love_primary"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"/>

                </LinearLayout>

                <View
                    android:layout_width="50dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/love_heart"/>

                <TextView
                    android:id="@+id/tv_identity_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="@color/love_text"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="6dp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_section_why"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="20dp"
                android:layout_marginTop="14dp"
                android:alpha="0"
                android:translationY="30dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💭"
                        android:textSize="20sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="为什么要开发一念？"
                        android:textSize="17sp"
                        android:textColor="@color/love_primary"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"/>

                </LinearLayout>

                <View
                    android:layout_width="50dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/love_heart"/>

                <TextView
                    android:id="@+id/tv_why_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="@color/love_text"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="6dp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_section_journey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="20dp"
                android:layout_marginTop="14dp"
                android:alpha="0"
                android:translationY="30dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛤️"
                        android:textSize="20sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="成长之路"
                        android:textSize="17sp"
                        android:textColor="@color/love_primary"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"/>

                </LinearLayout>

                <View
                    android:layout_width="50dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/love_heart"/>

                <LinearLayout
                    android:id="@+id/ll_timeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="14dp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_section_to_her"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="20dp"
                android:layout_marginTop="14dp"
                android:alpha="0"
                android:translationY="30dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💌"
                        android:textSize="20sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="对她的话"
                        android:textSize="17sp"
                        android:textColor="@color/love_primary"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"/>

                </LinearLayout>

                <View
                    android:layout_width="50dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/love_heart"/>

                <TextView
                    android:id="@+id/tv_to_her_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="@color/love_text"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="6dp"
                    android:gravity="center"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="14sp"
                android:textColor="@color/love_primary"
                android:layout_marginTop="32dp"
                android:alpha="0"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textStyle="italic"/>

            <TextView
                android:id="@+id/tv_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="一念 v1.0"
                android:textSize="11sp"
                android:textColor="@color/love_text_light"
                android:layout_marginTop="24dp"
                android:alpha="0.5"/>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/ll_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_glass_card"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="22sp"
            android:textColor="@color/love_primary"/>

    </LinearLayout>

</FrameLayout>
