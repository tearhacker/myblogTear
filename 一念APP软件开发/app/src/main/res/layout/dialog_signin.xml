<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dynamic_island"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_continuous"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:shadowColor="#40000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4"/>

    <TextView
        android:id="@+id/tv_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/signin_today_message"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:shadowColor="#30000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"/>

    <FrameLayout
        android:id="@+id/btn_signin_container"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_signin_glass_button"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/btn_signin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/signin_title"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_water_drop_small"
            android:drawablePadding="8dp"
            android:shadowColor="#40000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"/>

        <View
            android:id="@+id/ripple_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/ripple_water_drop"
            android:visibility="gone"/>

    </FrameLayout>

    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="点击签到，积累每一滴"
        android:textColor="#90FFFFFF"
        android:textSize="11sp"/>

</LinearLayout>
