<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6000000">

    <tear.conception.ui.view.RippleWaveView
        android:id="@+id/ripple_wave_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <tear.conception.ui.view.PetalParticleView
        android:id="@+id/petal_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="时光情书"
            android:textColor="#FF69B4"
            android:textSize="32sp"
            android:textStyle="bold"
            android:shadowColor="#FF1493"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="15"
            android:letterSpacing="0.2" />

        <View
            android:layout_width="80dp"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:background="#33FF69B4" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tv_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/game_intro_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:lineSpacingExtra="10dp"
                android:alpha="0.9"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp" />

        </ScrollView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/btn_accept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="接受"
                android:textColor="#FFB6C1"
                android:textSize="16sp"
                android:paddingLeft="36dp"
                android:paddingRight="36dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@drawable/bg_btn_replay"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_decline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="拒绝"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:paddingLeft="36dp"
                android:paddingRight="36dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@drawable/bg_btn_close"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
