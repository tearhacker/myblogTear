<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.star.dao.ApiSecretDao">

    <resultMap id="apiSecretMap" type="com.star.entity.ApiSecret">
        <id property="id" column="id"/>
        <result property="tearSecret" column="tear_secret"/>
        <result property="status" column="status"/>
        <result property="contact" column="contact"/>
        <result property="version" column="version"/>
        <result property="expireTime" column="expire_time"/>
        <result property="accessCount" column="access_count"/>
        <result property="todayCount" column="today_count"/>
        <result property="todayDate" column="today_date"/>
        <result property="lastAccessTime" column="last_access_time"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="findByTearSecret" resultMap="apiSecretMap">
        SELECT * FROM t_api_secret WHERE tear_secret = #{tearSecret}
    </select>

    <update id="updateAccessInfo">
        UPDATE t_api_secret 
        SET access_count = access_count + 1,
            today_count = CASE 
                WHEN today_date = CURDATE() THEN today_count + 1 
                ELSE 1 
            END,
            today_date = CURDATE(),
            last_access_time = NOW() 
        WHERE id = #{id}
    </update>

    <insert id="insertSecret" parameterType="com.star.entity.ApiSecret" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_api_secret (tear_secret, status, contact, version, expire_time, remark)
        VALUES (#{tearSecret}, #{status}, #{contact}, #{version}, #{expireTime}, #{remark})
    </insert>

    <update id="updateStatus">
        UPDATE t_api_secret SET status = #{status} WHERE id = #{id}
    </update>

    <select id="findAll" resultMap="apiSecretMap">
        SELECT * FROM t_api_secret ORDER BY id DESC
    </select>

    <delete id="deleteById">
        DELETE FROM t_api_secret WHERE id = #{id}
    </delete>

    <!-- 统计：全网总启动次数 -->
    <select id="sumAccessCount" resultType="java.lang.Long">
        SELECT COALESCE(SUM(access_count), 0) FROM t_api_secret
    </select>

    <!-- 统计：今日总启动次数 -->
    <select id="sumTodayCount" resultType="java.lang.Long">
        SELECT COALESCE(SUM(today_count), 0) FROM t_api_secret WHERE today_date = CURDATE()
    </select>

    <!-- 统计：活跃密钥数量 -->
    <select id="countActiveKeys" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM t_api_secret 
        WHERE status = 0 AND (expire_time IS NULL OR expire_time > NOW())
    </select>

</mapper>
